{
  "name": "murmur-community",
  "version": "0.1.1",
  "description": "Open-source desktop dictation for Windows and macOS: local speech recognition and optional bring-your-own-key cloud providers",
  "main": "./out/main/index.js",
  "author": "Yegor Burda-Vinakur",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:main": "vitest run --config vitest.config.main.ts",
    "test:smoke": "electron scripts/electron-smoke.cjs",
    "test": "npm run test:main && node scripts/check-packaging.mjs && node scripts/check-community-ui.mjs",
    "package:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/generative-ai": "^0.24.1",
    "@nut-tree-fork/nut-js": "^4.2.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "groq-sdk": "^0.12.0",
    "lucide-react": "^0.563.0",
    "openai": "^4.80.0",
    "tailwind-merge": "^3.4.0",
    "unbzip2-stream": "^1.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^7.3.0",
    "vitest": "^5.0.1"
  },
  "homepage": "https://github.com/airope/murmur-community",
  "repository": {
    "type": "git",
    "url": "https://github.com/airope/murmur-community.git"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
